# Copy this file to .streamlit/secrets.toml and add your own keys.
# Never commit real API keys.
OPENAI_API_KEY = ""
GEMINI_API_KEY = ""
ANTHROPIC_API_KEY = ""

[models]
agent_1_provider = "openai"
agent_1_model = "gpt-4o-mini"
agent_2_provider = "gemini"
agent_2_model = "gemini-2.0-flash"
agent_3_provider = "anthropic"
agent_3_model = "claude-3-5-haiku-latest"
agent_4_provider = "openai"
agent_4_model = "gpt-4o-mini"
chief_provider = "openai"
chief_model = "gpt-4o"
